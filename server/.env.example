# ==============================================================================
# VIDTUBE BACKEND PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas URI or local replica set)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vidtube?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Authentication & Cryptographic Keys
# Generate secure 64-character random hex keys for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_production_jwt_access_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin (Vercel Production Domain)
CLIENT_URL=https://vidtube-app.vercel.app

# Cloudinary Media Storage (Phase 3 & Phase 5)
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Upload Restrictions & Safety Thresholds
MAX_VIDEO_SIZE_MB=500
MAX_SHORT_SIZE_MB=100
MAX_SHORT_DURATION_SECONDS=60
MAX_THUMBNAIL_SIZE_MB=10

# SMTP Email Service (Optional for Password Reset in Production)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=VidTube Support <noreply@vidtube.com>
