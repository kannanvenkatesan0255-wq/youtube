# ==============================================================================
# VIDTUBE CLIENT PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Root URL (Render, Railway, or custom domain)
# For local development: http://localhost:5000/api
# For production: https://vidtube-api.onrender.com/api
VITE_API_BASE_URL=https://vidtube-api.onrender.com/api

# Optional: Realtime Socket.IO Server Endpoint (if separated from API base)
# Defaults to VITE_API_BASE_URL origin if omitted
VITE_SOCKET_URL=https://vidtube-api.onrender.com
