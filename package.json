{
  "name": "vidtube",
  "version": "1.0.0",
  "description": "VidTube — Full-Stack Video Sharing and Streaming Platform (YouTube Replica)",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan.bold,red.bold\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "install:all": "npm install",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "vidtube",
    "youtube-replica",
    "video-platform",
    "react19",
    "express",
    "mongodb",
    "full-stack"
  ],
  "author": "VidTube Team",
  "license": "ISC"
}

